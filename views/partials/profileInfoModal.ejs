<%
  function parseDemoDetails(description) {
    const details = {
      age: '',
      preferences: '',
      languages: '',
      verified: false
    };
    String(description || '').split('\n').forEach((line) => {
      const separator = line.indexOf(':');
      if (separator === -1) return;
      const key = line.slice(0, separator).trim().toLowerCase();
      const value = line.slice(separator + 1).trim();
      if (key === 'wiek') details.age = value;
      if (key === 'preferencje') details.preferences = value;
      if (key === 'języki' || key === 'jezyki') details.languages = value;
      if (key === 'zweryfikowana' || key === 'zweryfikowany' || key === 'weryfikacja') details.verified = value.toLowerCase() === 'tak';
    });
    return details;
  }
  const details = parseDemoDetails(listing.description);
  const username = listing.title;
  const authorName = listing.author_name || `Użytkownik ${listing.user_id}`;
  const promoted = Boolean(listing.is_promoted);
  const verified = Boolean(details.verified || Number(listing.owner_verified || 0));
  const modalRows = [
    ['Wiek', details.age],
    ['Miasto', listing.city],
    ['Sprzedający', authorName],
    ['Województwo', listing.region],
    ['Kategoria', listing.category],
    ['Preferencje', details.preferences],
    ['Języki', details.languages],
    ['Weryfikacja', verified ? 'Zweryfikowane' : 'Niezweryfikowane'],
    ['Promowanie', promoted ? 'Promowane' : 'Bez promocji']
  ].filter(([, value]) => value);
%>

<div class="profile-info-modal" id="<%= cardId %>" hidden>
  <div class="profile-info-panel" role="dialog" aria-modal="true" aria-labelledby="<%= cardId %>-title">
    <button class="profile-modal-close" type="button" data-modal-close aria-label="Zamknij">×</button>
    <div class="modal-profile-head">
      <img src="<%= listing.cover || '/uploads/demo-profiles/profile-01.svg' %>" alt="" loading="lazy" decoding="async">
      <div>
        <span><%= listing.category || 'Ogłoszenie' %></span>
        <h3 id="<%= cardId %>-title"><%= username %></h3>
        <p><%= listing.city %><%= listing.region ? ', ' + listing.region : '' %></p>
      </div>
    </div>
    <dl class="modal-profile-details">
      <% modalRows.forEach(([label, value]) => { %>
        <div><dt><%= label %></dt><dd><%= value %></dd></div>
      <% }) %>
    </dl>
  </div>
</div>
