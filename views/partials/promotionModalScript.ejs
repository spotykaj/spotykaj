<script>
  (() => {
    document.addEventListener('click', (event) => {
      const open = event.target.closest('[data-promotion-open]');
      if (open) {
        const modal = document.getElementById(open.dataset.promotionOpen);
        if (modal) {
          modal.hidden = false;
          document.body.classList.add('modal-open');
        }
        return;
      }
      if (event.target.matches('[data-promotion-close]') || event.target.classList.contains('promotion-package-modal')) {
        const modal = event.target.closest('.promotion-package-modal');
        if (modal) modal.hidden = true;
        if (!document.querySelector('.promotion-package-modal:not([hidden])')) {
          document.body.classList.remove('modal-open');
        }
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll('.promotion-package-modal:not([hidden])').forEach((modal) => {
        modal.hidden = true;
      });
      document.body.classList.remove('modal-open');
    });
  })();
</script>
