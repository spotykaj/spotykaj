<%- include('../partials/header') %>
<section class="auth-shell">
  <form class="form-card" action="/przypomnij-haslo" method="post">
    <p class="eyebrow">Bezpieczeństwo konta</p>
    <h1>Przypomnij hasło</h1>
    <p>Podaj adres e-mail konta. Jeżeli konto istnieje, wyślemy link do ustawienia nowego hasła.</p>
    <label>E-mail
      <input type="email" name="email" required autocomplete="email">
    </label>
    <button class="button" type="submit">Wyślij link</button>
    <p><a href="/logowanie">Wróć do logowania</a></p>
  </form>
</section>
<%- include('../partials/footer') %>
