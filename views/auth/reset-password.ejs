<%- include('../partials/header') %>
<section class="auth-shell">
  <div class="form-card">
    <p class="eyebrow">Bezpieczeństwo konta</p>
    <h1>Reset hasła</h1>
    <% if (invalidMessage) { %>
      <p><%= invalidMessage %></p>
      <a class="button" href="/przypomnij-haslo">Wyślij nowy link</a>
    <% } else { %>
      <form action="/reset-hasla" method="post">
        <input type="hidden" name="token" value="<%= token %>">
        <label>Nowe hasło
          <input type="password" name="password" minlength="8" required autocomplete="new-password">
        </label>
        <label>Powtórz nowe hasło
          <input type="password" name="password_confirmation" minlength="8" required autocomplete="new-password">
        </label>
        <button class="button" type="submit">Zmień hasło</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
